<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:StarZLauncher.Classes" xmlns:classes="clr-namespace:StarZLauncher.Classes" x:Class="StarZLauncher.Windows.MainWindow" mc:Ignorable="d" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True" Title="Lumina Launcher" Height="564" Width="904" Loaded="Window_Loaded">

    <Grid>

        <!-- Opening animation -->
        <Grid x:Name="OpeningAnim" Panel.ZIndex="10" Visibility="Visible">

            <Border Background="#111111" CornerRadius="20" BorderBrush="Silver" BorderThickness="0.5" Margin="1,0,-1,0"/>

            <Image x:Name="OpeningLogo" Source="/Resources/StarZLogo.png" Margin="239,141,265,297" RenderOptions.BitmapScalingMode="HighQuality"/>

            <Border Background="White" CornerRadius="2" BorderThickness="1" Margin="254,362,270,190">
                <ProgressBar Minimum="0" Maximum="1" Value="0" Background="Transparent" BorderThickness="0" Margin="0,0,0,0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush EndPoint="0.5,25" StartPoint="0,0">
                            <GradientStop Color="Silver" Offset="0"/>
                            <GradientStop Color="#ffffff" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="1" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
            </Border>

        </Grid>

        <Border x:Name="MenuMainBackground" Background="{DynamicResource PrimaryBackgroundColor}" Opacity="1" CornerRadius="20" Width="904" Height="564"/>

        <Border x:Name="SideBarBackground" Background="{DynamicResource SecondaryBackgroundColor}" Opacity="0.7" CornerRadius="15" Width="55" HorizontalAlignment="Left" Margin="25,138,0,25"/>

        <Border x:Name="TopBarBackground" Background="{DynamicResource SecondaryBackgroundColor}" Opacity="0.7" BorderThickness="0" CornerRadius="15" Margin="25,25,143,448"/>

        <Border x:Name="TopBarBackground2" Background="{DynamicResource SecondaryBackgroundColor}" Opacity="0.7" BorderThickness="0" CornerRadius="15" Margin="766,25,25,448"/>

        <Border x:Name="MainBackground" Background="{DynamicResource SecondaryBackgroundColor}" Opacity="0.7" CornerRadius="15" Width="757" HorizontalAlignment="Left" Margin="122,138,0,25"/>

        <Border x:Name="LogoBackground" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="15" Width="0" Height="80" Margin="1335,-391,-511,875"/>

        <Rectangle Name="DragWindow" Fill="Transparent" Height="90" Panel.ZIndex="2" Width="894" Opacity="0.1" Canvas.Left="14" Canvas.Top="27" HorizontalAlignment="Left" MouseLeftButtonDown="WindowToolbar_MouseLeftButtonDown" VerticalAlignment="Top" Margin="9,21,0,0"/>

        <Rectangle x:Name="CloseButton" Style="{DynamicResource IconsStyle}" Height="34" Margin="825,48,45,482" MouseLeftButtonDown="CloseButton_Click" RenderTransformOrigin="0.5, 0.5" Panel.ZIndex="3">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/CloseGray.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Rectangle.OpacityMask>
        </Rectangle>

        <Rectangle x:Name="MinimizeButton" Style="{DynamicResource IconsStyle}" Height="34" Margin="786,48,84,482" MouseLeftButtonDown="MinimizeButton_Click" RenderTransformOrigin="0.5, 0.5" Panel.ZIndex="3">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="/Resources/MinimizeGray.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Rectangle to apply the color tint -->
        <Image Source="/Resources/StarZLogoColoredPart.png" Width="70" HorizontalAlignment="Left" Margin="46,35,0,459" />

        <TextBlock x:Name="StarZText" Text="L U M I N A" Foreground="{DynamicResource TextColor}"  FontSize="24" FontFamily="HONOR Sans" Margin="139,54,597,464" FontWeight="Bold"/>

        <TextBlock x:Name="VersionText" Text="Launcher v0.2" FontSize="18" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="63991,507,143,36"/>



        <TabControl x:Name="SideBarTabControl" BorderThickness="0" Background="Transparent" Height="656" Width="904" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="SideBarTabControl_SelectionChanged" Opacity="0.9" Margin="2,0,0,0">



            <TabControl.Resources>


                <!-- Tab Control Style -->


                <Style TargetType="{x:Type TabItem}">


                    <Setter Property="Template">


                        <Setter.Value>


                            <ControlTemplate TargetType="{x:Type TabItem}">


                                <Border Name="Border" Cursor="Hand" Background="Transparent" Width="44" Height="44" CornerRadius="10,10,10,10">


                                    <ContentPresenter x:Name="ContentSite" Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>


                                </Border>


                                <ControlTemplate.Triggers>


                                    <Trigger Property="IsSelected" Value="True">


                                        <Setter TargetName="Border" Property="Background">
                                            <Setter.Value>
                                                <DynamicResource ResourceKey="Silver" />
                                            </Setter.Value>
                                        </Setter>


                                    </Trigger>


                                    <Trigger Property="IsSelected" Value="False">


                                        <Setter TargetName="Border" Property="Background" Value="Transparent"/>


                                    </Trigger>


                                    <MultiTrigger>


                                        <MultiTrigger.Conditions>


                                            <Condition Property="IsMouseOver" Value="True"/>


                                            <Condition Property="IsSelected" Value="False"/>


                                        </MultiTrigger.Conditions>


                                        <Setter TargetName="Border" Property="Background" Value="#33111111"/>


                                    </MultiTrigger>


                                </ControlTemplate.Triggers>


                            </ControlTemplate>


                        </Setter.Value>


                    </Setter>


                </Style>


            </TabControl.Resources>



            <!-- Tabs -->


            <TabItem x:Name="HomeTabItem" Foreground="{DynamicResource TextColor}"  Height="44" Margin="28,198,-29,-198">



                <TabItem.Header>


                    <Rectangle x:Name="HomeTab" Height="40" Width="40" RenderOptions.BitmapScalingMode="HighQuality" Fill="{DynamicResource IconColor}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Resources/HomeGray.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Rectangle.OpacityMask>
                    </Rectangle>



                </TabItem.Header>



                <Grid Margin="63,0,-2,0" Height="607">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="243*"/>
                        <RowDefinition Height="364*"/>
                    </Grid.RowDefinitions>



                    <TextBlock x:Name="HomeTextBlock" Text="Home" FontSize="50" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="537,35,164,150"/>



                    <Grid Height="607" Visibility="Visible" x:Name="HomeMenu" Opacity="1.0" Grid.RowSpan="2">


                        <Grid.Triggers>


                            <EventTrigger RoutedEvent="Loaded">


                                <BeginStoryboard>


                                    <Storyboard>


                                        <DoubleAnimation Storyboard.TargetName="HomeMenu" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>


                                    </Storyboard>


                                </BeginStoryboard>


                            </EventTrigger>


                        </Grid.Triggers>



                        <Grid Visibility="Visible" x:Name="MainMenu">


                            <Border x:Name="HomeBackground1" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="20" Margin="80,160,54,265">


                                <Border.Effect>


                                    <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>


                                </Border.Effect>


                            </Border>



                            <Border x:Name="HomeBackground2" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="20" Margin="80,369,321,97">


                                <Border.Effect>


                                    <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>


                                </Border.Effect>


                            </Border>



                            <Border x:Name="HomeBackground3" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="20" Margin="523,369,54,97">


                                <Border.Effect>


                                    <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>


                                </Border.Effect>


                            </Border>


                            <Viewbox Stretch="Uniform" Margin="250,174,250,391" RenderTransformOrigin="0.506,0.557">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="WelcomeBackTextBlock" Text="Greetings" FontSize="30" FontFamily="HONOR Sans" FontWeight="Medium" TextAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FFCB6868" Offset="0.005"/>
                                                <GradientStop Color="#FFB40707" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock x:Name="WelcomeUsernameTextBlock" Text=" !" FontSize="30" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  FontWeight="Medium" TextAlignment="Center"/>
                                </StackPanel>
                            </Viewbox>



                            <TextBlock x:Name="DiscordServerTextBlock" FontSize="30" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="208,381,457,184"><Run Text="Discord"/><LineBreak/><Run/></TextBlock>


                            <TextBlock x:Name="DiscordServerTextBlock2" Text="Lumina Community" FontSize="18" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="212,421,453,118" RenderTransformOrigin="0.736,0.531"/>


                            <!-- Rectangle to apply the color tint -->





                            <Rectangle x:Name="DiscordIconRectangle" Fill="{DynamicResource AccentColorGradientBrush}" RenderOptions.BitmapScalingMode="HighQuality" Margin="88,395,653,121" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="0.74"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                                <!-- Tint color -->
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Discord.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Rectangle.OpacityMask>
                            </Rectangle>



                            <Button Content="Join" Cursor="Hand" Foreground="{DynamicResource TextColor}"  FontWeight="Bold" FontFamily="HONOR Sans" Template="{StaticResource DefaultButtons}" Click="JoinDiscordServer_Click" Margin="218,460,467,0" Height="30" VerticalAlignment="Top" RenderTransformOrigin="0.526,0.563"/>



                            <TextBlock x:Name="LauncherVersionText" Text="Version Switcher" FontSize="24" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  FontWeight="Medium" Margin="554,388,85,191" Panel.ZIndex="3" Opacity="1"/>



                            <Label x:Name="LabelVersion" Content="N/A" FontFamily="HONOR Sans" FontSize="40px" Foreground="{DynamicResource TextColor}"  FontWeight="Bold" Margin="407,777,276,-237" Panel.ZIndex="3" Opacity="1" HorizontalContentAlignment="Left"/>



                            <Button Height="58" x:Name="LaunchButton" Content="PLAY" FontWeight="DemiBold" FontSize="25px" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" Foreground="{DynamicResource TextColor}"  FontFamily="HONOR Sans" Template="{StaticResource DefaultButtons}" VerticalAlignment="Top" Click="LaunchButton_OnLeftClick" MouseRightButtonDown="LaunchButton_OnRightClick" Margin="250,241,250,0" Background="#FFB51717">
                            </Button>



                            <Button x:Name="ShowFullList" Template="{StaticResource DefaultButtons}" Content="Switch Minecraft Version" Foreground="{DynamicResource TextColor}"  FontFamily="HONOR Sans" Background="Transparent" Cursor="Hand" BorderThickness="0" Margin="554,455,85,118" Click="ShowFullVersionsList_Click" RenderTransformOrigin="0.654,1.424">
                            </Button>



                            <Label x:Name="CurrentVersion" Content="N/A" Foreground="{DynamicResource TextColor}"  FontSize="12" FontFamily="HONOR Sans" HorizontalContentAlignment="Center" FontWeight="Medium" Margin="250,310,250,265"/>


                        </Grid>


                        <Grid x:Name="FullVersionsList" Margin="57,138,25,71" Visibility="Collapsed">



                            <TextBlock x:Name="FullVersionsListText" Text="Versions Manager" FontSize="30" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Opacity="1" Margin="255,2,255,350" TextAlignment="Center"/>



                            <TextBlock x:Name="InstallationStatus" Text="N/A" FontSize="15" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Opacity="1" Margin="64,44,10,332" TextAlignment="Left"/>



                            <TextBlock x:Name="StatusText" Text="Status:" FontSize="15" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Opacity="1" Margin="10,44,663,332" TextAlignment="Left"/>


                            <Rectangle Style="{DynamicResource IconsStyle}" Height="20" Panel.ZIndex="4" ToolTip="Go back." Width="20" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.7" Cursor="Hand" MouseLeftButtonDown="GoBackFullVersionList_MouseLeftButtonDown" Margin="10,10,727,368" RenderTransformOrigin="0.5, 0.5">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Arrow.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Rectangle.OpacityMask>
                            </Rectangle>


                            <ScrollViewer x:Name="versionsScrollView" VerticalScrollBarVisibility="Hidden" Margin="10,66,10,10" Opacity="0.8">


                                <ScrollViewer.Resources>


                                    <Style TargetType="{x:Type ScrollBar}">


                                        <Setter Property="Template">


                                            <Setter.Value>


                                                <ControlTemplate TargetType="{x:Type ScrollBar}">


                                                    <Grid>


                                                        <Border Background="Silver" Opacity="0.07" CornerRadius="5"/>


                                                        <Track IsDirectionReversed="True" Name="PART_Track" Visibility="Visible">


                                                            <Track.Thumb>


                                                                <Thumb Width="14" Height="200" Background="Silver" Opacity="0.7">


                                                                    <Thumb.Template>


                                                                        <ControlTemplate TargetType="Thumb">


                                                                            <Rectangle Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>


                                                                        </ControlTemplate>


                                                                    </Thumb.Template>


                                                                </Thumb>


                                                            </Track.Thumb>


                                                        </Track>


                                                    </Grid>


                                                </ControlTemplate>


                                            </Setter.Value>


                                        </Setter>


                                    </Style>


                                </ScrollViewer.Resources>


                                <StackPanel x:Name="versionsStackPanel"/>


                            </ScrollViewer>



                        </Grid>



                    </Grid>


                </Grid>



            </TabItem>



            <TabItem x:Name="ModulesTabItem" Foreground="{DynamicResource TextColor}"  Height="44" Margin="-16,263,15,-263">



                <TabItem.Header>


                    <Rectangle x:Name="ModulesTab" Height="35" Width="35" RenderOptions.BitmapScalingMode="HighQuality" Fill="{DynamicResource IconColor}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Resources/ModulesGray.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Rectangle.OpacityMask>
                    </Rectangle>



                </TabItem.Header>



                <Grid Margin="63,0,-2,0" Height="607">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="172*"/>
                        <RowDefinition Height="435*"/>
                    </Grid.RowDefinitions>



                    <TextBlock x:Name="ModulesTextBlock" Text="Modules" FontSize="50" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="477,34,159,68"/>



                    <Grid Height="607" Visibility="Visible" x:Name="ModulesMenu" Opacity="1.0" Grid.RowSpan="2">


                        <Grid.Triggers>


                            <EventTrigger RoutedEvent="Loaded">


                                <BeginStoryboard>


                                    <Storyboard>


                                        <DoubleAnimation Storyboard.TargetName="ModulesMenu" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>


                                    </Storyboard>


                                </BeginStoryboard>


                            </EventTrigger>


                        </Grid.Triggers>

                        <Border x:Name="CurrentlyInstalledDLLsBackground" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="4,4,4,4" Margin="79,153,50,424">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="DLLsMenuBar" BorderThickness="0" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="10" Margin="79,458,50,83">


                            <Border.Effect>


                                <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>


                            </Border.Effect>

                        </Border>

                        <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0" ItemsSource="{x:Static classes:ModsManager.ModItems}" Margin="56,190,26,154" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Hidden" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ModsItemsBackground" HorizontalAlignment="Center" BorderThickness="0" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="10" Padding="5,5,5,5" Width="710" Margin="0,10,0,10">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Image Binding -->
                                                        <Rectangle x:Name="ModImage" Fill="{DynamicResource IconColor}" RenderOptions.BitmapScalingMode="HighQuality" Width="100" Height="100">
                                                            <Rectangle.OpacityMask>
                                                                <ImageBrush ImageSource="{Binding ImageName}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <StackPanel Grid.Column="1" Margin="10">
                                                            <!-- DLL Type Text -->
                                                            <TextBlock Text="{Binding DisplayTypeText}" Foreground="{DynamicResource TextColor}"  FontFamily="HONOR Sans" FontSize="15"/>
                                                            <!-- DLL Name -->
                                                            <TextBlock Text="{Binding Name}" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  FontSize="16" FontWeight="Medium" Margin="0,5,0,0"/>
                                                            <!-- URL if Web-based DLL -->
                                                            <TextBlock Text="{Binding Url}" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  FontSize="10" Margin="0,0,0,0"/>
                                                            <!-- Edit Prompt -->
                                                            <TextBlock Text="Select me to edit!" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  FontSize="10" Margin="0,25,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ModsItemsBackground" Property="Opacity" Value="0.7"/>
                                                        <Setter TargetName="ModsItemsBackground" Property="BorderBrush" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ModsItemsBackground" Storyboard.TargetProperty="Background.(SolidColorBrush.Opacity)" To="0.7" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ModsItemsBackground" Storyboard.TargetProperty="Background.(SolidColorBrush.Opacity)" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border x:Name="DLLURLBackground" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="15" Margin="324,476,142,101">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>
                            </Border.Effect>

                            <!-- Grid to overlay the TextBox and the placeholder TextBlock -->
                            <Grid>
                                <!-- Placeholder TextBlock -->
                                <TextBlock x:Name="DLLURLTextBlock" Text="Paste in a URL and press 'Enter' on your keyboard." FontSize="15" FontWeight="Medium" FontFamily="HONOR Sans" Foreground="{DynamicResource TextColor}"  VerticalAlignment="Center" Opacity="0.3" Padding="10,5,10,5" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Visible" Width="373"/>

                                <!-- TextBox -->
                                <TextBox x:Name="dllurlTextBox" KeyDown="DllurlTextBox_KeyDown" Background="Transparent" BorderThickness="0" Padding="10,5,10,5" Foreground="{DynamicResource TextColor}"  FontWeight="Medium" FontFamily="HONOR Sans" FontSize="15" Width="374" Height="30" TextChanged="DllurlTextBox_TextChanged" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Label Content="Default Mod on launch: N/A" x:Name="DefaultDLLLabel" Foreground="{DynamicResource TextColor}"  Opacity="1" HorizontalContentAlignment="Left" FontFamily="HONOR Sans" FontWeight="Medium" Margin="93,155,63,426"/>



                        <Rectangle x:Name="DeleteIcon" ToolTip="Delete the selected Mod." Style="{DynamicResource IconsStyle}" Width="30" Height="30" Margin="267,476,542,101" MouseLeftButtonDown="Delete_MouseLeftButtonDown">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Delete.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Rectangle.OpacityMask>
                        </Rectangle>




                        <Rectangle x:Name="EditIcon" ToolTip="Edit the selected Mod." Style="{DynamicResource IconsStyle}" Width="30" Height="30" Margin="209,476,600,101" MouseLeftButtonDown="Edit_MouseLeftButtonDown">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Edit.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Rectangle.OpacityMask>
                        </Rectangle>




                        <Rectangle x:Name="DefaultModIcon" ToolTip="Set the selected Mod as default on launch." Style="{DynamicResource IconsStyle}" MouseLeftButtonDown="SetDefaultModButton_MouseLeftButtonDown" Height="30" Width="30" Margin="93,476,716,101">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/SetDefaultMod.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Rectangle.OpacityMask>
                        </Rectangle>




                        <Rectangle x:Name="ResetDefaultDLLIcon" Height="30" Width="30" ToolTip="Reset the default Mod to NONE." Style="{DynamicResource IconsStyle}" Margin="151,476,658,101" MouseLeftButtonDown="ResetSetDefaultDLLButton_MouseLeftButtonDown">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Reset.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Rectangle.OpacityMask>
                        </Rectangle>




                        <Button x:Name="AddDLLsButton" Content="+" Panel.ZIndex="4" ToolTip="Add a Mod from your computer." HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="DemiBold" FontSize="40px" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" Foreground="{DynamicResource TextColor}"  FontFamily="Inter" Template="{StaticResource DefaultButtons}" Margin="730,467,63,92" Click="AddDllsButton_OnLeftClick">
                        </Button>



                    </Grid>


                </Grid>



            </TabItem>



            <TabItem x:Name="ToolsTabItem" Foreground="{DynamicResource TextColor}"  Height="44" Margin="-60,327,59,-327">



                <TabItem.Header>


                    <Rectangle x:Name="ToolsTab" Height="40" Width="40" RenderOptions.BitmapScalingMode="HighQuality" Fill="{DynamicResource IconColor}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Resources/ToolsGray.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Rectangle.OpacityMask>
                    </Rectangle>



                </TabItem.Header>



                <Grid Margin="63,0,-2,0" Height="607">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="177*"/>
                        <RowDefinition Height="9"/>
                        <RowDefinition Height="421*"/>
                    </Grid.RowDefinitions>



                    <TextBlock x:Name="ToolsTextBlock" Text="Utilities" FontSize="50" FontFamily="HONOR Sans" FontWeight="Medium" Foreground="{DynamicResource TextColor}"  Margin="513,38,123,69"/>



                    <Grid Height="607" Visibility="Visible" x:Name="ToolsMenu" Opacity="1.0" Grid.RowSpan="3">


                        <Grid.Triggers>


                            <EventTrigger RoutedEvent="Loaded">


                                <BeginStoryboard>


                                    <Storyboard>


                                        <DoubleAnimation Storyboard.TargetName="ToolsMenu" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>


                                    </Storyboard>


                                </BeginStoryboard>


                            </EventTrigger>


                        </Grid.Triggers>



                        <Border x:Name="DragZone" Background="{DynamicResource SecondaryBackgroundColor}" BorderThickness="0" BorderBrush="{DynamicResource Silver}" CornerRadius="20" Margin="80,151,375,273">


                            <Border.Effect>


                                <DropShadowEffect BlurRadius="20" Opacity="0.3" RenderingBias="Performance" ShadowDepth="5"/>


                            </Border.Effect>


                        </Border>



