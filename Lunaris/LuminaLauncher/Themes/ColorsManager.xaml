<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
        <!-- Background Colors -->
        <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#F5F5F5" />
        <!-- Warm Off-White -->
        <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="#E8E8E8" />
        <!-- Soft Light Gray -->

        <!-- Text and Icon Colors -->
        <SolidColorBrush x:Key="TextColor" Color="#505050" />
        <!-- Muted Dark Gray -->
        <SolidColorBrush x:Key="IconColor" Color="#6B6F74" />
        <!-- Softer Gray for Icons -->

        <!-- Progress Bar Color -->
        <SolidColorBrush x:Key="ProgressBarColor" Color="#6B6F74" />
        <!-- Matches Icon Color -->

        <!-- Accent Gradient Brush -->
        <LinearGradientBrush x:Key="AccentColorGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1" SpreadMethod="Pad" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#c0e2c5" Offset="1.0" />
            <!-- Soft Blue-Gray -->
        <GradientStop Color="#c0e2c5" Offset="1.0" />
            <!-- Warm Light Gray -->
        <GradientStop Color="#c0e2c5" Offset="1.0" />
            <!-- Muted Grayish Blue -->
        </LinearGradientBrush>

    </ResourceDictionary>
